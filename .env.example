# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Vite / Next.js compatible)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_ADMIN_EMAIL="admin@kaverisilks.in"

# Next.js .env.local equivalents:
# NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# NEXT_PUBLIC_ADMIN_EMAIL="admin@kaverisilks.in"

# Boutique Payment & Concierge Settings
VITE_BOUTIQUE_UPI_ID="kaverisilks@okicici"
VITE_BOUTIQUE_WHATSAPP="919840012345"
